# Aiven Kafka (SSL) — B
# host:port affiché en mode "Client certificate"
KAFKA_BOOTSTRAP=
KAFKA_CA=certs/ca.pem
KAFKA_CERT=certs/service.cert
KAFKA_KEY=certs/service.key
KAFKA_TOPIC=hydro.raw

# Aiven ClickHouse — B
# host (ou host:port) de l'onglet "ClickHouse HTTPS & JDBC"
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Aiven PostgreSQL — B
# Service URI (postgres://...?sslmode=require)
DATABASE_URL=

# Aiven Valkey — B
# Service URI (rediss://...)
VALKEY_URL=

# ElevenLabs — T
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
DEMO_PHONE=

# Anthropic — S
ANTHROPIC_API_KEY=

# live | replay
DEMO_MODE=live
SITE_ID=1
# Repli du poller si site_stations (Postgres) n'est pas encore seedé
STATIONS=V505401001,V501401001
